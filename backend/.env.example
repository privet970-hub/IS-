# Application
DEBUG=false
APP_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/is_logistics

# OR-Tools Configuration
OR_TOOLS_TIME_LIMIT=30
OR_TOOLS_LOG_SEARCH=false

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_DISTANCE_MATRIX_CACHE=true
GOOGLE_MAPS_CACHE_TTL=3600

# API Settings
API_PORT=8000
